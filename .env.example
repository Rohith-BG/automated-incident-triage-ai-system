# ── Environment ──────────────────────────────────────────
ENVIRONMENT=dev

# ── Auth / JWT ───────────────────────────────────────────
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION

# ── Swappable Components ─────────────────────────────────
KG_BACKEND=in_memory
LLM_PROVIDER=google
NOTIFICATION_BACKEND=console
TICKET_BACKEND=noop

# ── LLM ──────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# ── Orchestrator ─────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.6
TOOL_TIMEOUT_SECONDS=30

# ── Tracing ──────────────────────────────────────────────
TRACING_ENABLED=true

# ── SQS (Production only — leave empty for dev) ─────────
# ALERT_SQS_QUEUE_URL=
# DEPLOY_SQS_QUEUE_URL=

# ── Neo4j (Production only — dev uses in_memory) ────────
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# ── PostgreSQL (Production only — dev uses SQLite) ───────
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/incident_triage

# ── GitHub (for code_diff MCP server in prod) ────────────
# GITHUB_TOKEN=
# GITHUB_API_BASE_URL=https://api.github.com

# ── Slack (future — leave empty for now) ─────────────────
# SLACK_WEBHOOK_URL=
