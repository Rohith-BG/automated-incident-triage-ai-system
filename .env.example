# ── Environment ──────────────────────────────────────────
ENVIRONMENT=dev

# ── Auth / JWT ───────────────────────────────────────────
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION

# Initial admin account — seeded on first startup when no users exist.
# Set these before the first boot; remove or leave empty afterwards.
# ADMIN_EMAIL=admin@yourcompany.com
# ADMIN_PASSWORD=a-strong-initial-password

# ── Swappable Components ─────────────────────────────────
# Real-source configuration (non-AWS): set these to use real GitHub
# + Neo4j + DB-backed incident knowledge. OBSERVABILITY_BACKEND has no
# non-AWS real backend (mock|cloudwatch) so it stays mock.
KG_BACKEND=neo4j
OBSERVABILITY_BACKEND=mock
DEPLOY_BACKEND=github
INCIDENT_KNOWLEDGE_BACKEND=db
CODE_DIFF_BACKEND=github
REPO_INTELLIGENCE_BACKEND=github
LLM_PROVIDER=google
NOTIFICATION_BACKEND=console
TICKET_BACKEND=noop
# Dev/mock equivalent (defaults):
# KG_BACKEND=in_memory
# DEPLOY_BACKEND=mock
# INCIDENT_KNOWLEDGE_BACKEND=mock
# CODE_DIFF_BACKEND=mock
# REPO_INTELLIGENCE_BACKEND=mock

# ── LLM ──────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# ── Orchestrator ─────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.6
TOOL_TIMEOUT_SECONDS=30

# ── Tracing ──────────────────────────────────────────────
TRACING_ENABLED=true

# ── SQS (Production only — leave empty for dev) ─────────
# ALERT_SQS_QUEUE_URL=
# DEPLOY_SQS_QUEUE_URL=
# Dead-letter queues for poison messages (recommended in production)
# ALERT_SQS_DLQ_URL=
# DEPLOY_SQS_DLQ_URL=

# ── Neo4j (KG_BACKEND=neo4j) ─────────────────────────────
# Cloud Aura (production / real):
# NEO4J_URI=bolt+s://<instance>.neo4j.io:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# Local Docker (dev):
# docker run --name neo4j -p 7687:7687 -p 7474:7474 \
#   -e NEO4J_AUTH=neo4j/password neo4j:5

# ── PostgreSQL (incident knowledge / backend DB) ──────────
# Dev uses the local SQLite fallback (triage.db) automatically when
# DATABASE_URL is unset. Set for a real Postgres:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/incident_triage

# ── GitHub (repo_intelligence / code_diff / deploy) ──────
# Required when any of the three backends above is 'github'.
# Fine-grained PAT with read access to the target repos.
# GITHUB_TOKEN=
# GITHUB_API_BASE_URL=https://api.github.com

# ── KG Bootstrap Agent ───────────────────────────────────
# Enable the first-run 'Build KG' flow. Source selects where the
# codebase topology comes from: github_org, github_repo, or the
# bundled services.json fixture (dev).
KG_BOOTSTRAP_ENABLED=true
# Real-source: build the graph from a single monolith repo.
# KG_BOOTSTRAP_SOURCE=github_repo
# KG_BOOTSTRAP_REPO=owner/monolith-repo
# KG_BOOTSTRAP_ARCHITECTURE=monolith
# Or scan a full GitHub org:
# KG_BOOTSTRAP_SOURCE=github_org
# KG_BOOTSTRAP_ORG=your-github-org
# KG_BOOTSTRAP_ARCHITECTURE=microservice
# Dev fallback (no network required):
KG_BOOTSTRAP_SOURCE=services_json
KG_BOOTSTRAP_ARCHITECTURE=microservice
KG_BOOTSTRAP_OWNER_TEAM=platform-team
# Start the dev in-memory graph EMPTY so the first-run onboarding /
# "Build KG" flow is testable end-to-end. Keep false (default) to seed
# from data/services.json for normal dev.
KG_IN_MEMORY_START_EMPTY=true

# ── Slack (future — leave empty for now) ─────────────────
# SLACK_WEBHOOK_URL=
